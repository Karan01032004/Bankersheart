<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder2" runat="server">
     <section id="inner-banner" class="content-down">
        <div class="container">
            <div class="row">
                <div class="banner-heading">
                    <h2 class="text-white text-center mb-0">Visitor Guidelines</h2>
                </div>
            </div>
        </div>
    </section>
    <section id="hospital-details" class="py-5">
        <div class="container py-lg-4">
            <div class="blog-container text-lg-start text-center pt-lg-3">
               <%-- <h2 class="clr-black fw-bold d-lg-none d-block pb-3">Visitor Guidelines</h2>--%>
                <div class="inner-img ">
                      <picture>
                        <source srcset="assets/img/vision-guidlines-img.webp" type="image/webp">
                        <source srcset="assets/img/vision-guidlines-img.png" type="image/png">
                        <img class="img-fluid  rounded-4 mb-4" src="assets/img/vision-guidlines-img.png" alt="Visitor Guidelines">
                    </picture>
                </div>
                <div class="blogs-content">
                   <h2 class="clr-black fw-bold d-lg-block d-none">Visitor Guidelines</h2>
                   
                    <p>Patients and their visitors must understand that the hospital has set rules and guidelines
                        for visitors in the best interest of the recovery of patients. Please follow the guidelines 
                        mentioned below when visiting a relative or a friend at any of our hospitals:</p>

                    <ul class="ps-4">
                        <li>Please keep noise to a minimum by limiting the number of visitors.</li>
                        <li>Waiting rooms are for the use of multiple families; please be respectful of others while using these spaces.</li>
                        <li>Do not visit with an infectious disease, such as a cold or flu. We encourage you to use hand sanitizer or wash your hands often to keep family safe.</li>
                        <li>Children are welcome; however, they must be in good health and supervised by an adult at all times.</li>
                        <li>Pets are not permitted in any of our hospitals.</li>
                        <li>Cell phones are prohibited in some areas. Ask your nurse if you have questions about using your cell phone.</li>
                        <li>Visiting hours are 10 am – 12 PM in the morning and 5 PM – 7 PM in the evening. Please restrict visitors to these times only.</li>
                    </ul>
                   
                  
                </div>
                
                
            </div>

        </div>
    </section>
