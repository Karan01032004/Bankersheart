<asp:Content ID="Content3" ContentPlaceHolderID="extrajs" runat="server">
    <script type="text/javascript">
        function validateFileUpload() {
            var fileUpload = document.getElementById('<%= fuResume.ClientID %>');
            var filePath = fileUpload.value;
            var file = fileUpload.files[0];
            var allowedExtensions = /(\.doc|\.docx|\.pdf)$/i;
            var maxSizeMB = 5;
            var maxSizeBytes = maxSizeMB * 1024 * 1024; // 5MB in bytes

            if (file) {
                if (!allowedExtensions.exec(filePath)) {
                    alert('Invalid file type. Only .doc, .docx, and .pdf files are allowed.');
                    fileUpload.value = ''; // Clear the file upload control
                    return false;
                }

                if (file.size > maxSizeBytes) {
                    alert('File size exceeds the 5MB limit.');
                    fileUpload.value = ''; // Clear the file upload control
                    return false;
                }
            }

            return true;
        }
    </script>
     <script>
         function removeHttpHttps(textbox) {
             var currentValue = textbox.value;

             // Remove URLs and domain-like patterns
             var urlPattern = /\b(http|https|www|localhost|[a-zA-Z0-9\-]+\.[a-zA-Z]{2,})\b/gi;
             currentValue = currentValue.replace(urlPattern, "");

             // Remove HTML tags
             var htmlTagPattern = /<[^>]*>/gi;
             currentValue = currentValue.replace(htmlTagPattern, "");

             // Remove coding-related keywords (html, script, iframe, style, etc.)
             var codeWordsPattern = /\b(html|script|iframe|style|body|head|title|meta|link|div|span|form|input|textarea|button)\b/gi;
             currentValue = currentValue.replace(codeWordsPattern, "");

             textbox.value = currentValue;
         }
     </script>
</asp:Content>
