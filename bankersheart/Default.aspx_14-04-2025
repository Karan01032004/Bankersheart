    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.open-modal').forEach(function (element) {
                element.addEventListener('click', function (event) {
                    event.preventDefault();
                    let title = this.getAttribute('data-title');
                    let image = this.getAttribute('data-image');

                    document.getElementById('modalTitle').innerText = title;
                    document.getElementById('modalImage').setAttribute('src', image);
                    document.getElementById('modalImage').setAttribute('alt', title);

                    var myModal = new bootstrap.Modal(document.getElementById('patientModal'));
                    myModal.show();
                });
            });
        });
