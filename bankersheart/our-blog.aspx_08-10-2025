<%@ Page Title="Our Blog | Latest Health Insights & Medical Updates" Language="C#" MasterPageFile="~/bankers.Master" AutoEventWireup="true" CodeBehind="our-blog.aspx.cs" Inherits="bankersheart.our_blog" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
    <link rel="canonical" href="https://www.bankersheart.com/our-blog">
      <meta name="description" content="Stay informed with the latest health insights, medical advancements, and expert healthcare tips from Bankers Group of Hospitals. Explore blogs on wellness, treatments, and patient care.">
    <style>
        .tittle-height {
    height: 155px;
}
    </style>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder2" runat="server">
    <section id="inner-banner" class="content-down">
        <div class="container">
            <div class="row">
                <div class="banner-heading">
                    <h2 class="text-white text-center mb-0">Our Blog</h2>
                </div>
            </div>
        </div>
    </section>
    <div id="blog-section">
        <div class="container py-5">
            <div class="row">
                <asp:Repeater ID="rpt_MedicalCamps" runat="server">
                    <ItemTemplate>
                        <div class="col-lg-4 col-md-6 pt-5">
                            <a href='blog-details.aspx?id=<%# Eval("id") %>'>
                                <div class="box-shadow-date text-center p-3 h-100">
                                    <div class="position-relative">
                                        <%--   <picture>
                                         <source srcset="https://www.bankersheart.com/assets/img/events-bankers-img-1.webp" type="image/webp">
                                         <source srcset="https://www.bankersheart.com/assets/img/events-bankers-img-1.png" type="image/png">
                                         <img class="img-fluid  rounded-4" src="https://www.bankersheart.com/assets/img/events-bankers-img-1.png" alt="Blog-details">
                                     </picture>--%>
                                        <picture>
                                            <source srcset='<%# ResolveUrl("~/poweradmin/webfiles/BlogManagement/") + Eval("image") %>' type="image/webp">
                                            <source srcset='<%# ResolveUrl("~/poweradmin/webfiles/BlogManagement/") + Eval("image") %>' type="image/png">
                                            <img class="img-fluid  rounded-4 media-img"
                                                src='<%# ResolveUrl("~/poweradmin/webfiles/BlogManagement/") + Eval("image") %>'
                                                alt='<%# Eval("title") %>'>
                                        </picture>

                                        <%--  <p class="date-fix py-1 mb-0 px-3">17<br />sept</p>--%>
                                        <p class="date-fix py-1 mb-0 px-3">
                                            <%# Convert.ToDateTime(Eval("Blog_Date")).ToString("dd") %><br />
                                            <%# Convert.ToDateTime(Eval("Blog_Date")).ToString("MMM") %>
                                        </p>

                                    </div>
                                    <div class="pb-4">
                                        <div class="tittle-height">

                                        
                                        <h6 class="pt-5  clr-black fw-semibold clamped-text"><%# Eval("title") %></h6>
                                        <p class="clamped-text"><%# Eval("summary") %></p>
                                            </div>
                                        <%-- <div class="mt-4"><a href="https://www.bankersheart.com/blog-details" class="btn-theme btn-blue">Know More</a></div>--%>
                                             <a href='blog-details.aspx?id=<%# Eval("id") %>' class="btn-theme btn-blue">Know More</a>


                                    </div>

                                </div>

                            </a>
                        </div>
                    </ItemTemplate>
                </asp:Repeater>




            </div>

            <%--<div class="row pt-5 mt-3 justify-content-center text-center">

                <div class="col-12 carousal-arrow">
                    <a href="#"><i class="fa fa-long-arrow-left "></i></a>

                    <a href="#" class="px-3 active">1</a>
