                    <a href="#"><i class="fa fa-long-arrow-right"></i></a>
                </div>

            </div>--%>
            <div class="row pt-5 mt-3 justify-content-center text-center">
    <asp:PlaceHolder ID="PaginationBlogPlaceholder" runat="server"></asp:PlaceHolder>
</div>

        </div>

    </div>
</asp:Content>
