<%@ Page Title="" Language="C#" MasterPageFile="~/bankers.Master" AutoEventWireup="true" CodeBehind="interesting-case-details.aspx.cs" Inherits="bankersheart.interesting_case_details" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
    <%-- <style>
        #hospital-details .inner-img {
   
    width: 35%;
    min-width: 300px;
    margin-left: 30px;
}
    </style>--%>
    <%--<link rel="canonical" href="https://www.bankersheart.com/interesting-case-details">--%>
    <style>
        /* Justify all CKEditor content inside ck-justify */
        .ck-justify,
        .ck-justify * {
            text-align: justify !important;
            text-justify: inter-word !important;
        }
    </style>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder2" runat="server">
    <section id="inner-banner" class="content-down">
        <div class="container">
            <div class="row">
                <div class="banner-heading">
                    <!-- Dynamic H1 will show the title -->
                    <h1 id="pageH1" runat="server" class="sr-only"></h1>
                    <h2 class="text-white text-center mb-0">Interesting Cases</h2>
                </div>
            </div>
        </div>
    </section>
    <section id="hospital-details" class="py-5">
        <asp:Repeater ID="rptExhibitionscategory" runat="server">
            <ItemTemplate>
                <div class="container py-lg-4">
                    <div class="blog-container text-lg-start text-center pt-lg-3">
                        <h2 class="clr-black fw-bold d-lg-none d-block"><%# Eval("title") %></h2>
                        <div class="inner-img mb-lg-0 mb-4">
                            <%--    <picture>
                        <source srcset="https://www.bankersheart.com/assets/img/interesting-case-detail-img-1.webp" type="image/webp">
                        <source srcset="https://www.bankersheart.com/assets/img/interesting-case-detail-img-1.png" type="image/png">
                        <img class="img-fluid  rounded-4" src="https://www.bankersheart.com/assets/img/interesting-case-detail-img-1.png" alt="Twiddlers Syndrome">
                    </picture>--%>
                            <picture>
                                <source srcset='<%# ResolveUrl("~/poweradmin/webfiles/InterestingCasesCategory/") + Eval("image") %>' type="image/webp">
                                <source srcset='<%# ResolveUrl("~/poweradmin/webfiles/InterestingCasesCategory/") + Eval("image") %>' type="image/png">
                                <img class="img-fluid  rounded-4 cases-details-height"
                                    src='<%# ResolveUrl("~/poweradmin/webfiles/InterestingCasesCategory/") + Eval("image") %>'
                                    alt='<%# Eval("title") %>'>
                            </picture>
                        </div>
                        <div class="blogs-content">
                            <h2 class="clr-black fw-bold d-lg-block d-none"><%# Eval("title") %></h2>

                            <div class="ck-justify">
                                <%# Eval("description") %>
                            </div>

                            <%--         <p>Some people have a habit of turning, playing or twiddling with their pacemakers.
                     This can cause leads of the pacemaker to be pulled out. In the first 2 pictures, 
                     the leads can easily be seen circling the pacemaker, a sure sign of being twiddled with.</p>
                    <p>Our team went ahead to correct this problem and educate the patient about leaving their pacemaker 
as is.</p>--%>
                        </div>


                    </div>

                </div>
            </ItemTemplate>
        </asp:Repeater>
    </section>


    <div id="interesting-gallery">

        <div class="container pb-5">

            <div class="row pb-5">
                <h2 class="clr-black fw-semibold text-lg-start text-center">Gallery</h2>
                <h3></h3>
                <h4></h4>
                <h5></h5>
                <asp:Repeater ID="rptExhibitionsGallery" runat="server">
                    <ItemTemplate>
                        <div class="col-lg-3 col-md-4 col-6 pt-4">
                            <a href='<%# ResolveUrl("~/poweradmin/webfiles/InterestingCases/") + Eval("InterestingCasesImage") %>' data-fancybox="gallery">
                                <%--  <picture>
                        <source srcset="https://www.bankersheart.com/assets/img/interesting-case-detail-img-1.webp" type="image/webp">
                        <source srcset="https://www.bankersheart.com/assets/img/interesting-case-detail-img-1.png" type="image/png">
                        <img class="img-fluid  rounded-4" src="https://www.bankersheart.com/assets/img/interesting-case-detail-img-1.png" alt="Twiddlers Syndrome">
                    </picture>--%>
                                <picture>
                                    <source srcset='<%# ResolveUrl("~/poweradmin/webfiles/InterestingCases/") + Eval("InterestingCasesImage") %>' type="image/webp">
                                    <source srcset='<%# ResolveUrl("~/poweradmin/webfiles/InterestingCases/") + Eval("InterestingCasesImage") %>' type="image/png">
                                    <img class="img-fluid  rounded-4 cases-height"
                                        src='<%# ResolveUrl("~/poweradmin/webfiles/InterestingCases/") + Eval("InterestingCasesImage") %>'
                                        alt='<%# Eval("title") %>'>
                                </picture>
                            </a>
                        </div>
                    </ItemTemplate>
                </asp:Repeater>
            </div>

        </div>

    </div>

</asp:Content>
<asp:Content ID="Content3" ContentPlaceHolderID="extrajs" runat="server">
</asp:Content>
