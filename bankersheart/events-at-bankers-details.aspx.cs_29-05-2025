using bankersheart.App_Code;
using System;
using System.Data;
using System.Web;
using System.Web.UI;
using System.Web.UI.WebControls;

namespace bankersheart
{
    public partial class events_at_bankers_details : System.Web.UI.Page
    {
        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
                if (Request.QueryString["Eventid"] != null)
                {
                    rptExhibitions.DataSource = null;
                    rptExhibitions.DataBind();
                    Bindexhibition();
                }
                else if (Request.QueryString["lectureid"] != null)
                {
                    Lectures.DataSource = null;
                    Lectures.DataBind();
                    BindLectures();
                }
                else if (Request.QueryString["Rallyid"] != null)
                {
                    Rally.DataSource = null;
                    Rally.DataBind();
                    BindRally();
                }
                else if (Request.QueryString["Conferenceid"] != null)
                {
                    Conference.DataSource = null;
                    Conference.DataBind();
                    BindConference();
                }
                else
                {
                    Response.Redirect("default.aspx");
                }
            }
        }

        private void Bindexhibition()
        {
            string eventId = Request.QueryString["Eventid"];
            string query = "SELECT e.id AS EventsatBankersId, e.title, e.description, e.shortdescription, e.EventsatBankers_Date, i.image AS EventsatBankersImage " +
                           "FROM [bankers_usr].[EventsatBankers] e " +
                           "LEFT JOIN [bankers_usr].[EventsatBankers_Images] i ON e.id = i.EventsatBankers_id " +
                           "WHERE e.id = " + eventId;

            DataTable dt = new DAL().GetDataTable(query, CommandType.Text, null);
            rptExhibitions.DataSource = dt;
            rptExhibitions.DataBind();

            if (dt.Rows.Count > 0)
            {
                lblCampDescription.Text = dt.Rows[0]["description"].ToString();
            }
        }

        private void BindLectures()
        {
            string lectureId = Request.QueryString["lectureid"];
            string query = "SELECT e.id AS LecturesId, e.title, e.description, e.shortdescription, e.Lectures_Date, i.image AS LecturesImage " +
                           "FROM [bankers_usr].[Lectures] e " +
                           "LEFT JOIN [bankers_usr].[Lectures_Images] i ON e.id = i.Lectures_id " +
                           "WHERE e.id = " + lectureId;

            DataTable dt = new DAL().GetDataTable(query, CommandType.Text, null);
            Lectures.DataSource = dt;
            Lectures.DataBind();

            if (dt.Rows.Count > 0)
            {
                lblCampDescription.Text = dt.Rows[0]["description"].ToString();
            }
        }

        private void BindRally()
        {
            string rallyId = Request.QueryString["Rallyid"];
            string query = "SELECT e.id AS RallyId, e.title, e.description, e.shortdescription, e.Rally_Date, i.image AS RallyImage " +
                           "FROM [bankers_usr].[Rally] e " +
                           "LEFT JOIN [bankers_usr].[Rally_Images] i ON e.id = i.Rally_id " +
                           "WHERE e.id = " + rallyId;

            DataTable dt = new DAL().GetDataTable(query, CommandType.Text, null);
            Rally.DataSource = dt;
            Rally.DataBind();

            if (dt.Rows.Count > 0)
            {
                lblCampDescription.Text = dt.Rows[0]["description"].ToString();
            }
        }

        private void BindConference()
        {
            string conferenceId = Request.QueryString["Conferenceid"];
            string query = "SELECT e.id AS ConferenceId, e.title, e.description, e.shortdescription, e.Conference_Date, i.image AS ConferenceImage " +
                           "FROM [bankers_usr].[Conference] e " +
                           "LEFT JOIN [bankers_usr].[Conference_Images] i ON e.id = i.Conference_id " +
                           "WHERE e.id = " + conferenceId;

            DataTable dt = new DAL().GetDataTable(query, CommandType.Text, null);
            Conference.DataSource = dt;
            Conference.DataBind();

            if (dt.Rows.Count > 0)
            {
                lblCampDescription.Text = dt.Rows[0]["description"].ToString();
            }
        }
    }
}
