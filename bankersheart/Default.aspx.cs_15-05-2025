        private void BindData()
        {
            string id = Request.QueryString["id"];
            ddlHospital.Items.Clear();
            ddlHospital.Items.Insert(0, new ListItem("Select Hospital", "", true));

            ddlDoctor.Items.Clear();
            // ddlDoctor.Items.Insert(0, new ListItem("Select Doctor", "", true));

            if (!string.IsNullOrEmpty(id))
            {
                hasDoctorId = true; // ID exists
                BindDoctorAndHospitals(id);
            }
            else
            {
                hasDoctorId = false; // No ID
                BindAllHospitals();
            }
        }
        private void BindDoctorAndHospitals(string id)
        {
            string query = "SELECT Name, Profession, hospitals FROM [bankers_usr].[DoctorDetails] WHERE id = @id";
            SqlParameter[] parameters = { new SqlParameter("@id", id) };
            DataTable dt = new DAL().GetDataTable(query, CommandType.Text, parameters);

            if (dt.Rows.Count > 0)
            {
                string doctorName = dt.Rows[0]["Name"].ToString();
                string profession = dt.Rows[0]["Profession"].ToString();
                string hospitalList = dt.Rows[0]["hospitals"].ToString();

                // Bind single doctor
                ddlDoctor.Items.Add(new ListItem($"{doctorName} ({profession})", doctorName));
                ddlDoctor.Enabled = false; // Keep doctor name fixed

                // Bind only hospitals where this doctor works
                PopulateHospitalsDropdown(hospitalList);
            }
        }

        private void BindAllHospitals()
        {
            string query = "SELECT DISTINCT hospitals FROM [bankers_usr].[DoctorDetails]";
            DataTable dt = new DAL().GetDataTable(query, CommandType.Text, null);

            if (dt.Rows.Count > 0)
            {
                string allHospitals = string.Join(";", dt.AsEnumerable().Select(row => row["hospitals"].ToString()).Distinct());
                PopulateHospitalsDropdown(allHospitals);
            }
            // Show "Select Doctor" message if no doctor ID is provided
            ddlDoctor.Items.Clear();
            ddlDoctor.Items.Add(new ListItem("Select Doctor", "", true));
        }

        private void PopulateHospitalsDropdown(string hospitals)
        {
            string[] hospitalList = hospitals.Split(';');

            foreach (string hospital in hospitalList)
            {
                if (!string.IsNullOrWhiteSpace(hospital) && ddlHospital.Items.FindByText(hospital.Trim()) == null)
                {
                    ddlHospital.Items.Add(new ListItem(hospital.Trim(), hospital.Trim()));
                }
            }
        }

        protected void ddlHospital_SelectedIndexChanged(object sender, EventArgs e)
        {
            // Agar pehle se doctor fixed hai, toh doctor list change nahi karenge
            if (hasDoctorId)
            {
                return;
            }

            ddlDoctor.Items.Clear();
            //  ddlDoctor.Items.Insert(0, new ListItem("Select Doctor", "", true));

            string selectedHospital = ddlHospital.SelectedValue;
            if (!string.IsNullOrEmpty(selectedHospital))
            {
                string query = "SELECT Name, Profession FROM [bankers_usr].[DoctorDetails] WHERE hospitals LIKE @hospital";
                SqlParameter[] parameters = { new SqlParameter("@hospital", "%" + selectedHospital + "%") };
                DataTable dt = new DAL().GetDataTable(query, CommandType.Text, parameters);

                if (dt.Rows.Count > 0)
                {
                    foreach (DataRow row in dt.Rows)
                    {
                        string doctorName = row["Name"].ToString();
                        string profession = row["Profession"].ToString();
                        string displayText = $"{doctorName} ({profession})";

                        ddlDoctor.Items.Add(new ListItem(displayText, doctorName));
                    }
                }
            }
            ScriptManager.RegisterStartupScript(this, GetType(), "ScrollToDropdown", "ScrollToDropdown('" + ddlHospital.ClientID + "');", true);

        }
        protected void btnsubmit_Click(object sender, EventArgs e)
        {
            try
            {
                if (Page.IsValid)
                {
                    if (this.Session["CaptchaImageText"] == null || txtCaptcha.Text.ToLower() != this.Session["CaptchaImageText"].ToString().ToLower())
                    {
                        // If CAPTCHA validation fails, display an error message and stop execution
                        lblERR.Text = "Invalid Captcha Code Entered.";
                        string script = @"<script>window.location.href = '#targetSection';</script>";
                        ClientScript.RegisterStartupScript(GetType(), "ScrollToSection", script);
                        return; // Stop further execution
                    }

                    // If CAPTCHA is correct, proceed with form processing
                    string hospital = ddlHospital.SelectedValue;
                    string doctor = ddlDoctor.SelectedValue;
                    string patientName = txtName.Text.Trim();
                    string mobileNo = txtPhone.Text.Trim();
                    string email = txtEmail.Text.Trim();
                    DateTime parsedDate;
                    string dateFormatted = DateTime.TryParse(txtDate.Text.Trim(), out parsedDate)
                        ? parsedDate.ToString("dd MMMM yyyy")
                        : txtDate.Text.Trim();

                    DateTime parsedTime;
                    string time = DateTime.TryParse(txtTime.Text.Trim(), out parsedTime)
                        ? parsedTime.ToString("hh:mm tt") // 12-hour format with AM/PM
                        : txtTime.Text.Trim(); // fallback to original input if parsing fails
                    string addeddate = DateTime.Now.ToString("dd-MM-yyyy HH:mm:ss");

                    // Validate required fields
                    if (string.IsNullOrEmpty(hospital) || string.IsNullOrEmpty(doctor) || string.IsNullOrEmpty(patientName))
                    {
                        lblMessage.Text = "Please fill in all required fields.";
                        lblMessage.ForeColor = System.Drawing.Color.Red;
                        return;
                    }

                    string userIpAddress = GetIpAddress();

                    #region Mail To Admin
                    string curDate;
                    DateTime d = DateTime.UtcNow.AddHours(4);
                    curDate = d.ToString("dd-MMM-yyyy");

                    // Load Email Template
                    string mailtemplate = System.IO.File.ReadAllText(GetRootPath() + "maintemplates/Appointment.htm");
                    mailtemplate = mailtemplate.Replace("_DATE_", DateTime.Now.ToString("dd-MM-yyyy"));
                    mailtemplate = mailtemplate.Replace("_NAME_", patientName.Replace(System.Environment.NewLine, "<br/>"));
                    mailtemplate = mailtemplate.Replace("_EMAIL_", email.Replace(System.Environment.NewLine, "<br/>"));
                    mailtemplate = mailtemplate.Replace("_MOBILE_", mobileNo.Replace(System.Environment.NewLine, "<br/>"));
                    mailtemplate = mailtemplate.Replace("_DATE1_", dateFormatted.Replace(Environment.NewLine, "<br/>"));
                    mailtemplate = mailtemplate.Replace("_TIME1_", time.Replace(System.Environment.NewLine, "<br/>"));
                    mailtemplate = mailtemplate.Replace("_HOSPITAL_", hospital.Replace(System.Environment.NewLine, "<br/>"));
                    mailtemplate = mailtemplate.Replace("_DOCTOR_", doctor.Replace(System.Environment.NewLine, "<br/>"));
                    mailtemplate = mailtemplate.Replace("_IP_ADDRESS1_", userIpAddress);
                    string recipientEmail = "";
                    if (hospital == "Bankers Heart Institute, Vadodara")
                    {
                        recipientEmail = "opd.bhi@gmail.com";  // Send email to this address if selected hospital is "Bankers Heart Institute, Vadodara"
                    }
                    else
                    {
                        recipientEmail = ConfigurationManager.AppSettings["ContactEmail"].ToString();  // Default email address from configuration
                    }
                    // Send Mail
                    MailToSendSite(recipientEmail, "BankersHeart Appointment Form", ConfigurationManager.AppSettings["UserName"].ToString(), mailtemplate, "", "", patientName, txtEmail.Text);
                    #endregion

                    // Insert Appointment Data into Database
                    string query = @"INSERT INTO [bankers_usr].[Appointment]
                ([Hospital Name], [Doctor Name], [Patient Name], [MobileNo], [Email],  [Date], [time]) 
                VALUES (@Hospital, @Doctor, @PatientName, @MobileNo, @Email,  @Date, @Time)";

                    SqlParameter[] parameters =
                    {
                new SqlParameter("@Hospital", hospital),
                new SqlParameter("@Doctor", doctor),
                new SqlParameter("@PatientName", patientName),
                new SqlParameter("@MobileNo", mobileNo),
                new SqlParameter("@Email", email),
new SqlParameter("@Date", parsedDate),
                new SqlParameter("@Time", time),
            };

                    int result = new DAL().ExecuteNonQuery(query, CommandType.Text, parameters);

                    if (result > 0)
                    {
                        lblMessage.Text = "Appointment booked successfully!";
                        lblMessage.ForeColor = System.Drawing.Color.Green;

                        // Clear Form Fields
                        ClearFields();

                        // Redirect to Thank You Page
                        Response.Redirect("thank-you.html");
                    }
                    else
                    {
                        lblMessage.Text = "Error while booking appointment. Try again!";
                        lblMessage.ForeColor = System.Drawing.Color.Red;
                    }
                }
            }
            catch (Exception ex)
            {
                lblMessage.Text = "An error occurred: " + ex.Message;
                lblMessage.ForeColor = System.Drawing.Color.Red;
            }
        }


        private string GetIpAddress()
        {
            string ipAddress = Request.ServerVariables["HTTP_X_FORWARDED_FOR"];
            if (string.IsNullOrEmpty(ipAddress))
            {
                ipAddress = Request.ServerVariables["REMOTE_ADDR"];
            }
            return ipAddress;
        }

        public static string GetRootPath()
        {
            string completePath = HttpContext.Current.Server.MapPath(HttpContext.Current.Request.ApplicationPath).Replace("/", "\\");
            string rootPath = completePath + "\\";
            return rootPath;
        }
        private void ClearFields()
        {
            ddlHospital.SelectedIndex = 0;
            ddlDoctor.SelectedIndex = 0;
            txtName.Text = "";
            txtPhone.Text = "";
            txtEmail.Text = "";
            txtDate.Text = "";
            txtTime.Text = "";
        }
        public static int MailToSendSite(string tomail, string mailsubject, string frommail, string bodymail, string ccmail, string bccmail, string fromname, string replyToMail)
        {
            try
            {

                string HostName = ConfigurationManager.AppSettings["HostName"].ToString();
                string User = ConfigurationManager.AppSettings["UserName"].ToString();
                string password = ConfigurationManager.AppSettings["Password"].ToString();
                if (tomail == "")
                    tomail = ConfigurationManager.AppSettings["ContactEmail"].ToString();
                if (frommail == "")
                    frommail = ConfigurationManager.AppSettings["UserName"].ToString();

                //string HostName = "mail.yourwebsitepreview.com";
                //string User = "forms@yourwebsitepreview.com";
                //string password = "forms@123";

                SmtpClient smtpClientC = new SmtpClient();
                MailMessage objMailC = new MailMessage();
                MailAddress objMailC_fromaddress = new MailAddress(frommail, fromname);
                MailAddress objMailC_toaddress = new MailAddress(tomail);
                //MailAddress objMailC_replyto = new MailAddress(frommail);


                objMailC.From = objMailC_fromaddress;
                objMailC.To.Add(objMailC_toaddress);
                // objMailC.ReplyToList.Add(objMailC_replyto);

                objMailC.IsBodyHtml = true;

                objMailC.Subject = mailsubject;

                objMailC.Body = bodymail;
                // Add ReplyTo address
                if (!string.IsNullOrEmpty(replyToMail))
                {
                    objMailC.ReplyToList.Add(new MailAddress(replyToMail));
                }
                if (ccmail != null && ccmail != "")
                {
                    objMailC.CC.Add(ccmail);
                }

                if (bccmail != null & bccmail != "")
                {
                    objMailC.Bcc.Add(bccmail);
                }
                //objMailC.Bcc.Add("websitetesting99@gmail.com");

                smtpClientC.Host = HostName;
                //smtpClientC.Port = 587;
                //smtpClientC.Port = 465;
                smtpClientC.Port = 587;
               smtpClientC.EnableSsl = true;
                smtpClientC.Credentials = new System.Net.NetworkCredential(User, password);
                smtpClientC.Send(objMailC);
                return 1;

            }
            catch (Exception ex)
            {
                throw ex;

            }


        }
