        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
                int pageIndex = 1;
                if (!string.IsNullOrEmpty(Request.QueryString["medicalcamppage"]))
                {
                    int.TryParse(Request.QueryString["medicalcamppage"], out pageIndex);

                    // ✅ Redirect page 1 to clean URL
                    if (pageIndex == 1)
                    {
                        Response.Status = "301 Moved Permanently";
                        Response.AddHeader("Location", "/medical-camp");
                        Response.End();
                        return;
                    }
                }

                BindAwards(pageIndex);

                // ✅ Set page title dynamically
                if (pageIndex > 1)
                {
                    Page.Title = "Free Health Checkups - Page " + pageIndex + " | Bankers Group of Hospitals";
                    pageH1.InnerText = "Free Health Checkups - Page " + pageIndex;

                }
                else
                {
                    Page.Title = "Free Health Checkups | Bankers Group of Hospitals";
                    pageH1.InnerText = "Free Health Checkups";

                }

                // ✅ Set canonical URL dynamically
                string canonicalUrl = "https://www.bankersheart.com/medical-camp";
                if (pageIndex > 1)
                {
                    canonicalUrl += $"?medicalcamppage={pageIndex}";
                }

                canonicalLink.Attributes["href"] = canonicalUrl;
            }
        }


        private void BindAwards(int pageIndex)
        {
            int pageSize = 9; // Number of records per page
            int startRow = (pageIndex - 1) * pageSize;

            string query = $@"
    WITH Medical_Camp_CTE AS
    (
        SELECT [id], [title],[titlelink], [image], [shortdescription], [Camp_Date], 
               ROW_NUMBER() OVER (ORDER BY Camp_Date DESC) AS RowNum
        FROM [bankers_usr].[Medical_Camp]
    )
    SELECT * FROM Medical_Camp_CTE 
    WHERE RowNum BETWEEN {startRow + 1} AND {startRow + pageSize}";

            DataTable dt = new DAL().GetDataTable(query, CommandType.Text, null);
            rpt_MedicalCamps.DataSource = dt;
            rpt_MedicalCamps.DataBind();

            // Fetch total record count
            string countQuery = "SELECT COUNT(*) FROM [bankers_usr].[Medical_Camp]";
            int totalRecords = Convert.ToInt32(new DAL().ExecuteScalar(countQuery, CommandType.Text, null));
            int totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

            // Generate pagination controls
            GenerateMedicalCampPaginationControls(pageIndex, totalPages);
        }
        private void GenerateMedicalCampPaginationControls(int currentPage, int totalPages)
        {
            StringBuilder sb = new StringBuilder();
            sb.Append("<div class='col-12 carousal-arrow'>");

            // Previous Button
            if (currentPage > 1)
            {
                sb.Append($"<a href='?medicalcamppage={currentPage - 1}'><i class='fa fa-long-arrow-left'></i></a>");
            }
            else
            {
                sb.Append("<span class='px-3 text-muted'><i class='fa fa-long-arrow-left'></i></span>");
            }

            // Page Numbers
            for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                    sb.Append($"<span class='px-3 active'>{i}</span>");
                else
                    sb.Append($"<a href='?medicalcamppage={i}' class='px-3'>{i}</a>");
            }

            // Next Button
            if (currentPage < totalPages)
            {
                sb.Append($"<a href='?medicalcamppage={currentPage + 1}'><i class='fa fa-long-arrow-right'></i></a>");
            }
            else
            {
                sb.Append("<span class='px-3 text-muted'><i class='fa fa-long-arrow-right'></i></span>");
            }

            sb.Append("</div>");

            PaginationMedicalCampPlaceholder.Controls.Clear();
            PaginationMedicalCampPlaceholder.Controls.Add(new Literal { Text = sb.ToString() });
        }

