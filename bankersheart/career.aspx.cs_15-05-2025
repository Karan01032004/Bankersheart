        protected void btnSubmit_Click(object sender, EventArgs e)
        {
            try
            {
                if (Page.IsValid)
                {
                    if (this.Session["CaptchaImageText"] != null && txtCaptcha.Text == this.Session["CaptchaImageText"].ToString())
                    {

                        string resumeFilePath = string.Empty;
                        string fileName = string.Empty;

                        // Check if a file was uploaded
                        if (fuResume.HasFile)
                        {
                            // Validate file size and type (optional)
                            if (fuResume.PostedFile.ContentLength <= 5 * 1024 * 1024 && // Max 5MB
                                (fuResume.PostedFile.ContentType == "application/pdf" ||
                                 fuResume.PostedFile.ContentType == "application/msword" ||
                                 fuResume.PostedFile.ContentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document"))
                            {
                                // Generate a unique file name
                                string fileExtension = Path.GetExtension(fuResume.FileName);
                                string uniqueFileName = Guid.NewGuid().ToString().Substring(0, 8) + fileExtension;
                                fileName = uniqueFileName;

                                // Save the file to a server directory
                                string folderPath = Server.MapPath("~/careerresume/");
                                if (!Directory.Exists(folderPath))
                                {
                                    Directory.CreateDirectory(folderPath);
                                }

                                resumeFilePath = Path.Combine(folderPath, fileName);
                                fuResume.SaveAs(resumeFilePath);

                                // Convert the file path for use in the database
                                resumeFilePath = "~/careerresume/" + fileName;
                            }
                            else
                            {
                                ShowError("Invalid file type or size. Please upload a DOC, DOCX, or PDF file up to 5MB.");

                                return;
                            }
                        }

                        // Prepare SQL query to insert into careerbandvcontractingenterprises table
                        string strQuery = "INSERT INTO [bankers_usr].[career] (firstname, positionAppliedFor, email,Message, phoneno, uploadResume,added_date,modified_ip) VALUES " +
                                   "(@FirstName, @PositionAppliedFor, @Email, @Message,@PhoneNo, @UploadResume,SYSDATETIMEOFFSET(),@ModifiedIP)";

                        using (SqlConnection conn = new SqlConnection(ConfigurationManager.ConnectionStrings["Connection"].ConnectionString))
                        {
                            conn.Open();
                            using (SqlCommand cmd = new SqlCommand(strQuery, conn))
                            {
                                cmd.Parameters.AddWithValue("@FirstName", txtName.Text);
                                //cmd.Parameters.AddWithValue("@PositionAppliedFor", ddlPosition.SelectedItem.Text); // Fetch selected position
                                cmd.Parameters.AddWithValue("@PositionAppliedFor", txtPosition.Text);

                                cmd.Parameters.AddWithValue("@Email", txtEmail.Text);
                                cmd.Parameters.AddWithValue("@phoneno", txtMobile.Text);
                                cmd.Parameters.AddWithValue("@Message", txtMessage.Text);
                                // Convert to your time zone (IST = UTC +5:30, adjust as needed)
                                DateTime localTime = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "India Standard Time");

                                cmd.Parameters.AddWithValue("@AddedDate", localTime);


                                // Get the user's IP address
                                string userIP = HttpContext.Current.Request.UserHostAddress;
                                cmd.Parameters.AddWithValue("@ModifiedIP", userIP);
                                cmd.Parameters.AddWithValue("@UploadResume", fileName); // Save only the file name


                                cmd.ExecuteNonQuery();
                            }
                        }

                        string userIpAddress = GetIpAddress();

                        // Prepare and send the email
                        string strBody = System.IO.File.ReadAllText(GetRootPath() + "maintemplates/career.htm");

                        strBody = strBody.Replace("_DATE", DateTime.Now.ToString("dd-MMM-yyyy"));
                        strBody = strBody.Replace("_FIRSTNAME_", txtName.Text);
                        strBody = strBody.Replace("_APPLIEDFOR_", txtPosition.Text); // Fetch selected position
                        //strBody = strBody.Replace("_APPLIEDFOR_", ddlPosition.SelectedItem.Text); // Fetch selected position
                        strBody = strBody.Replace("_Email_", txtEmail.Text);
                        strBody = strBody.Replace("_Message_", txtMessage.Text);
                        strBody = strBody.Replace("_PHONE_", txtMobile.Text);
                        strBody = strBody.Replace("_IP_ADDRESS_", userIpAddress);


                        // Generate full URL for the resume file
                        string resolvedUrl = ResolveUrl(resumeFilePath);
                        strBody = strBody.Replace("_UPLOAD_", resolvedUrl);

                        // Send the email with attachment
                        HttpPostedFile uploadedFile = fuResume.PostedFile;

                        int mailsent = MailToSendSite(
                            "", // tomail
                           "Career Enquiry",
                            "",
                            strBody,
                            null, // ccmail
                            null, // bccmail
                            txtName.Text.Replace("'", "''") + " " ,
                            uploadedFile // Pass the uploaded file as an attachment
                        );


                        if (mailsent == 1)
                        {
                            // Clear fields and redirect on success
                            txtName.Text = "";
                            txtMobile.Text = "";
                            txtEmail.Text = "";
                            Response.Redirect(ConfigurationManager.AppSettings["siteurl"].ToString() + "/thank-you.html");
                        }
                        else
                        {
                            ShowError("Failed to send email. Please try again later.");

                        }
                    }
                    else
                    {
                        ////div_Error.Visible = true;
                        //lblERR.Visible = true;
                        //lblERR.Text = "Please enter correct captcha.";
                        lblERR.Text = "Invalid Captcha Code Entered.";
                        string script = @"<script>
                        window.location.href = '#targetSection';
                    </script>";
                        ClientScript.RegisterStartupScript(GetType(), "ScrollToSection", script);
                    }
                }
            }
            catch (Exception ex)
            {
                ShowError("An error occurred: " + ex.Message);

            }
        }
        private string GetIpAddress()
        {
            string ipAddress = Request.ServerVariables["HTTP_X_FORWARDED_FOR"];
            if (string.IsNullOrEmpty(ipAddress))
            {
                ipAddress = Request.ServerVariables["REMOTE_ADDR"];
            }
            return ipAddress;
        }
        private void ShowError(string message)
        {
            lblERR.Text = message;

            // div_Error.Visible = true;
            ScriptManager.RegisterStartupScript(this, GetType(), "ScrollToError", "scrollToError();", true);
            return;
        }


