        private void BindAwards(int pageIndex)
        {
            int pageSize = 3; // Number of records per page
            int startRow = (pageIndex - 1) * pageSize;

            string query = $@"
    WITH Blog_CTE AS
    (
        SELECT [id], [title], [image], [Blog_Date], [summary], 
               ROW_NUMBER() OVER (ORDER BY Blog_Date DESC) AS RowNum
        FROM [bankers_usr].[BlogManagement]
    )
    SELECT * FROM Blog_CTE 
    WHERE RowNum BETWEEN {startRow + 1} AND {startRow + pageSize}";

            DataTable dt = new DAL().GetDataTable(query, CommandType.Text, null);
            rpt_MedicalCamps.DataSource = dt;
            rpt_MedicalCamps.DataBind();

            // Fetch total record count
            string countQuery = "SELECT COUNT(*) FROM [bankers_usr].[BlogManagement]";
            int totalRecords = Convert.ToInt32(new DAL().ExecuteScalar(countQuery, CommandType.Text, null));
            int totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

            // Generate pagination controls
            GenerateBlogPaginationControls(pageIndex, totalPages);
        }
        private void GenerateBlogPaginationControls(int currentPage, int totalPages)
        {
            StringBuilder sb = new StringBuilder();
            sb.Append("<div class='col-12 carousal-arrow'>");

            // Previous Button
            if (currentPage > 1)
            {
                sb.Append($"<a href='?blogPage={currentPage - 1}'><i class='fa fa-long-arrow-left'></i></a>");
            }
            else
            {
                sb.Append("<a href='#'><i class='fa fa-long-arrow-left text-muted'></i></a>");
            }

            // Page Numbers
            for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                    sb.Append($"<a href='#' class='px-3 active'>{i}</a>");
                else
                    sb.Append($"<a href='?blogPage={i}' class='px-3'>{i}</a>");
            }

            // Next Button
            if (currentPage < totalPages)
            {
                sb.Append($"<a href='?blogPage={currentPage + 1}'><i class='fa fa-long-arrow-right'></i></a>");
            }
            else
            {
                sb.Append("<a href='#'><i class='fa fa-long-arrow-right text-muted'></i></a>");
            }

            sb.Append("</div>");

            PaginationBlogPlaceholder.Controls.Clear();
            PaginationBlogPlaceholder.Controls.Add(new Literal { Text = sb.ToString() });
        }

    }
