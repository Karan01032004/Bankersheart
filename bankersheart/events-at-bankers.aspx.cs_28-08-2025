        private void BindAwards(int pageIndex)
        {
            int pageSize = 9; // Display only 3 records per page
            int startRow = (pageIndex - 1) * pageSize;
     
            string query = $@"
        WITH Events_CTE AS
        (
            SELECT [id], [title],[titlelink], [image], [EventsatBankers_Date], [shortdescription], 
                   ROW_NUMBER() OVER (ORDER BY EventsatBankers_Date DESC) AS RowNum
            FROM [bankers_usr].[EventsatBankers]
        )
        SELECT * FROM Events_CTE 
        WHERE RowNum BETWEEN {startRow + 1} AND {startRow + pageSize}";

            DataTable dt = new DAL().GetDataTable(query, CommandType.Text, null);
            rpt_MedicalCamps.DataSource = dt;
            rpt_MedicalCamps.DataBind();

            // Fetch total record count
            string countQuery = "SELECT COUNT(*) FROM [bankers_usr].[EventsatBankers]";
            int totalRecords = Convert.ToInt32(new DAL().ExecuteScalar(countQuery, CommandType.Text, null));
            int totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

            // Generate pagination controls
            GeneratePaginationControls(pageIndex, totalPages);
        }

        private void GeneratePaginationControls(int currentPage, int totalPages)
        {
            StringBuilder sb = new StringBuilder();
            sb.Append("<div class='col-12 carousal-arrow'>");
            events_tab.Attributes.Add("class", "nav-link active");
            events.Attributes.Add("class", "tab-pane fade active show");
            rally_tab.Attributes.Add("class", "nav-link");
            Rally1.Attributes.Add("class", "tab-pane fade ");
            conference_tab.Attributes.Add("class", "nav-link");
            conference1.Attributes.Add("class", "tab-pane fade ");
            lecture_tab.Attributes.Add("class", "nav-link ");
            lecture.Attributes.Add("class", "tab-pane fade");
            // Previous Button
            if (currentPage > 1)
            {
                sb.Append($"<a href='?c=Event&page={currentPage - 1}'><i class='fa fa-long-arrow-left'></i></a>");
            }
            else
            {
                sb.Append("<a href='#'><i class='fa fa-long-arrow-left text-muted'></i></a>");
            }

            // Page Numbers (1, 2, 3, etc.)
            for (int i = 1; i <= totalPages; i++)
            {
                if (i == currentPage)
                    sb.Append($"<a href='#' class='px-3 active'>{i}</a>");
                else
                    sb.Append($"<a href='?c=Event&page={i}' class='px-3'>{i}</a>");
            }

            // Next Button
            if (currentPage < totalPages)
            {
                sb.Append($"<a href='?c=Event&page={currentPage + 1}'><i class='fa fa-long-arrow-right'></i></a>");
            }
            else
            {
                sb.Append("<a href='#'><i class='fa fa-long-arrow-right text-muted'></i></a>");
            }

            sb.Append("</div>");

            PaginationPlaceholder.Controls.Clear();
            PaginationPlaceholder.Controls.Add(new Literal { Text = sb.ToString() });
        }


