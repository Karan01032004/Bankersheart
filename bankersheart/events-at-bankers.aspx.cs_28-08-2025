        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
               
                int pageIndex = 1;
                if (!string.IsNullOrEmpty(Request.QueryString["page"]))
                {
                    int.TryParse(Request.QueryString["page"], out pageIndex);
                }
                if(Request.QueryString.Count == 0)
                {
                    BindAwards(pageIndex);

                
                }
                else
                {
                    if (Request.QueryString["c"].ToString() == "Event")
                    {
                        BindAwards(pageIndex);

                       // BindPlayCard();
                    }
                    else if(Request.QueryString["c"].ToString() == "lecture")
                    {
                        BindLecture(Convert.ToInt32(Request.QueryString["lecturepage"].ToString()));
                    }
                    else if(Request.QueryString["c"].ToString() == "rally")
                    {
                        BindRally(Convert.ToInt32(Request.QueryString["rallypage"].ToString()));
                    }
                    else if(Request.QueryString["c"].ToString() == "conference")
                    {
                        BindConference(Convert.ToInt32(Request.QueryString["conferencepage"].ToString()));
                    }
                 

                }
            }
        }
