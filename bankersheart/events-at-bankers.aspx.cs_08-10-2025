        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
                int pageIndex = 1; // default for events
                int lecturePage = 1, rallyPage = 1, conferencePage = 1;

                // --- Events pagination ---
                if (!string.IsNullOrEmpty(Request.QueryString["page"]))
                {
                    int.TryParse(Request.QueryString["page"], out pageIndex);
                    if (pageIndex == 1)
                    {
                        string cleanUrl = Request.Url.AbsoluteUri.ToLower().Replace("?page=1", "").Replace("&page=1", "");
                        Response.Redirect(cleanUrl, true);
                        return;
                    }
                }

                // --- Lecture pagination ---
                if (!string.IsNullOrEmpty(Request.QueryString["lecturepage"]))
                {
                    int.TryParse(Request.QueryString["lecturepage"], out lecturePage);
                    if (lecturePage == 1)
                    {
                        string cleanUrl = Request.Url.AbsoluteUri.ToLower().Replace("?lecturepage=1", "").Replace("&lecturepage=1", "");
                        Response.Redirect(cleanUrl, true);
                        return;
                    }
                }

                // --- Rally pagination ---
                if (!string.IsNullOrEmpty(Request.QueryString["rallypage"]))
                {
                    int.TryParse(Request.QueryString["rallypage"], out rallyPage);
                    if (rallyPage == 1)
                    {
                        string cleanUrl = Request.Url.AbsoluteUri.ToLower().Replace("?rallypage=1", "").Replace("&rallypage=1", "");
                        Response.Redirect(cleanUrl, true);
                        return;
                    }
                }

                // --- Conference pagination ---
                if (!string.IsNullOrEmpty(Request.QueryString["conferencepage"]))
                {
                    int.TryParse(Request.QueryString["conferencepage"], out conferencePage);
                    if (conferencePage == 1)
                    {
                        string cleanUrl = Request.Url.AbsoluteUri.ToLower().Replace("?conferencepage=1", "").Replace("&conferencepage=1", "");
                        Response.Redirect(cleanUrl, true);
                        return;
                    }
                }

                string pageTitle = "Bankers Group of Hospitals"; // Default title
                string h1Text = "Bankers Events";               // Default H1
                string pageDescription = "Discover the latest events at Bankers Group of Hospitals."; // Default meta description

                // Check query string to determine content
                if (Request.QueryString.Count == 0)
                {
                    BindAwards(pageIndex);
                    pageTitle = "Events at Bankers";
                    h1Text = "Event at Bankers";
                    pageDescription = "Discover the latest events at Bankers Group of Hospitals, including cultural celebrations, medical conferences, and community outreach initiatives in Vadodara.";
                }
                else
                {
                    string contentType = Request.QueryString["c"]?.ToString().ToLower();
                    switch (contentType)
                    {
                        case "event":
                            BindAwards(pageIndex);
                            pageTitle = "Events at Bankers";
                            h1Text = "Events at Bankers";
                            pageDescription = "Discover the latest events at Bankers Group of Hospitals in Vadodara.";
                            if (pageIndex > 1)
                            {
                                pageTitle += $" - Page {pageIndex}";
                                h1Text += $" - Page {pageIndex}";
                                pageDescription += $" - Page {pageIndex}";
                            }
                            break;

                        case "lecture":
                            BindLecture(lecturePage);
                            pageTitle = "Lectures at Bankers";
                            h1Text = "Lectures at Bankers";
                            pageDescription = "Explore upcoming lectures and medical talks at Bankers Group of Hospitals in Vadodara.";
                            if (lecturePage > 1)
                            {
                                pageTitle += $" - Page {lecturePage}";
                                h1Text += $" - Page {lecturePage}";
                                pageDescription += $" - Page {lecturePage}";
                            }
                            break;

                        case "rally":
                            BindRally(rallyPage);
                            pageTitle = "Rallies at Bankers";
                            h1Text = "Rallies at Bankers";
                            pageDescription = "Join community rallies organized by Bankers Group of Hospitals in Vadodara.";
                            if (rallyPage > 1)
                            {
                                pageTitle += $" - Page {rallyPage}";
                                h1Text += $" - Page {rallyPage}";
                                pageDescription += $" - Page {rallyPage}";
                            }
                            break;

                        case "conference":
                            BindConference(conferencePage);
                            pageTitle = "Conferences at Bankers";
                            h1Text = "Conferences at Bankers";
                            pageDescription = "Stay updated on medical conferences and workshops at Bankers Group of Hospitals in Vadodara.";
                            if (conferencePage > 1)
                            {
                                pageTitle += $" - Page {conferencePage}";
                                h1Text += $" - Page {conferencePage}";
                                pageDescription += $" - Page {conferencePage}";
                            }
                            break;
                    }
                }

                // Set the title, H1 and meta description
                Page.Title = pageTitle;
                litHeading.Text = $"<h1 class='sr-only'>{h1Text}</h1>";
                metaDescription.Attributes["content"] = pageDescription;

                // Update canonical link
                canonicalLink.Attributes["rel"] = "canonical";
                canonicalLink.Attributes["href"] = Request.Url.AbsoluteUri;
            }
        }


